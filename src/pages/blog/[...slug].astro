---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { groupBySeries } from '../../lib/series';
import { blogPostingSchema, breadcrumbSchema, graph, personSchema, postModified } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const { series } = groupBySeries(posts);
  return posts.map((post) => {
    let seriesInfo = null;
    if (post.data.series) {
      const group = series.find((s) => s.name === post.data.series);
      if (group) {
        const index = group.posts.findIndex((p) => p.id === post.id);
        const prev = group.posts[index - 1];
        const next = group.posts[index + 1];
        seriesInfo = {
          name: group.name,
          slug: group.slug,
          part: post.data.part ?? index + 1,
          total: group.posts.length,
          prev: prev ? { id: prev.id, title: prev.data.title } : null,
          next: next ? { id: next.id, title: next.data.title } : null,
        };
      }
    }
    return {
      params: { slug: post.id },
      props: { post, seriesInfo },
    };
  });
}

const { post, seriesInfo } = Astro.props;
const { Content } = await render(post);

const pageTitle = seriesInfo
  ? `${seriesInfo.name}: ${post.data.title} | Max Kelly`
  : `${post.data.title} | Max Kelly`;

const crumbs = [
  { name: 'Home', path: '/' },
  ...(seriesInfo ? [{ name: seriesInfo.name, path: `/series/${seriesInfo.slug}` }] : []),
  { name: post.data.title, path: `/blog/${post.id}` },
];
const jsonLd = graph(
  blogPostingSchema(post, seriesInfo),
  breadcrumbSchema(crumbs),
  personSchema(),
);
---

<BaseLayout
  title={pageTitle}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date}
  modifiedTime={postModified(post)}
  markdownUrl={`/blog/${post.id}.md`}
  jsonLd={jsonLd}
>
  <nav>
    <a href="/">← Back</a>
  </nav>
  <article>
    <header>
      {seriesInfo && (
        <p class="series-label">
          <a href={`/series/${seriesInfo.slug}`}>{seriesInfo.name}</a>
          <span class="muted"> · Part {seriesInfo.part} of {seriesInfo.total}</span>
        </p>
      )}
      <p class="byline muted">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          })}
        </time>
        <span> · by <a href="/" rel="author">Max Kelly</a></span>
      </p>
      <h1>{post.data.title}</h1>
      <h5 class="muted">{post.data.status}</h5>
    </header>
    <div class="prose">
      <Content />
    </div>
    {seriesInfo && (seriesInfo.prev || seriesInfo.next) && (
      <nav class="series-nav">
        {seriesInfo.prev ? (
          <a href={`/blog/${seriesInfo.prev.id}`}>← {seriesInfo.prev.title}</a>
        ) : (
          <span />
        )}
        {seriesInfo.next ? (
          <a href={`/blog/${seriesInfo.next.id}`}>{seriesInfo.next.title} →</a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  nav {
    margin-bottom: 3rem;
  }
  nav a {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  nav a:hover {
    color: var(--text);
  }
  article header {
    margin-bottom: 2.5rem;
  }
  .series-label {
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }
  .series-label a {
    color: var(--accent);
    border-bottom: none;
  }
  .series-label a:hover {
    border-bottom: 1px solid var(--accent);
  }
  .series-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #262626;
    font-size: 0.85rem;
  }
  .series-nav a {
    color: var(--text-muted);
    border-bottom: none;
  }
  .series-nav a:hover {
    color: var(--accent);
  }
  .byline {
    font-size: 0.8rem;
  }
  .byline a {
    color: inherit;
    border-bottom: none;
  }
  .byline a:hover {
    color: var(--text);
  }
  article header h1 {
    font-size: 1.6rem;
    margin-top: 0.5rem;
    line-height: 1.3;
  }
  .prose :global(p) {
    margin-bottom: 1.25rem;
  }
  .prose :global(h2) {
    font-size: 1.2rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose :global(h3) {
    font-size: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose :global(code) {
    background: #1a1a1a;
    padding: 0.15rem 0.35rem;
    border-radius: 3px;
    font-size: 0.9em;
  }
  .prose :global(pre) {
    background: #1a1a1a;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(a) {
    color: var(--link);
    border-bottom: 1px solid var(--text-muted);
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }
  .prose :global(ul), .prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
  }
  .prose :global(img), .prose :global(video) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .prose :global(figure) {
    margin: 2rem 0;
  }
  .prose :global(figcaption) {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-align: center;
  }
  .prose :global(.phones) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
    align-items: start;
  }
  .prose :global(.phones img) {
    width: 100%;
  }
  .prose :global(figure.phone img) {
    max-width: 280px;
    margin: 0 auto;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
    font-size: 0.85rem;
  }
  .prose :global(th), .prose :global(td) {
    border-bottom: 1px solid #262626;
    padding: 0.4rem 0.5rem;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid #262626;
    margin: 2.5rem 0;
  }
</style>
