---
import { career } from '../data/resume';
---

<section class="section">
  <h2 class="section-header">Career</h2>
  {career.map((job) => (
    <details class="job-entry">
      <summary>
        <div class="job-row">
          <div>
            <span class="job-role">{job.role}, </span>
            {job.url ? (
              <a href={job.url} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">
                {job.company} ↗
              </a>
            ) : (
              <span>{job.company}</span>
            )}
          </div>
          <span class="dates muted">
            {job.start}{job.end ? ` - ${job.end}` : ' -'}
          </span>
        </div>
        <div class="role-type muted">
          {job.type}<span class="expand-hint"></span>
        </div>
      </summary>
      <div class="job-detail">
        {job.tagline && <p class="tagline muted">{job.tagline}</p>}
        <ul>
          {job.highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
        {job.tech && <p class="tech muted">{job.tech.join(' · ')}</p>}
      </div>
    </details>
  ))}
  <p class="cv-link">
    <a href="/cv">view full cv →</a>
  </p>
</section>

<style>
  .job-entry {
    padding: 0.3rem 0;
  }
  summary {
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover .job-role {
    color: var(--accent);
  }
  .job-role {
    transition: color 0.2s;
  }
  .job-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .role-type {
    font-size: 0.75rem;
    display: block;
  }
  .expand-hint::after {
    content: ' · more +';
  }
  details[open] .expand-hint::after {
    content: ' · less −';
  }
  .dates {
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .job-detail {
    margin: 0.5rem 0 0.75rem;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    font-size: 0.85rem;
  }
  .tagline {
    font-style: italic;
    margin-bottom: 0.5rem;
  }
  .job-detail ul {
    margin-bottom: 0.5rem;
  }
  .tech {
    font-size: 0.75rem;
  }
  .cv-link {
    margin-top: 1.5rem;
    font-size: 0.85rem;
  }
  .cv-link a {
    color: var(--text-muted);
  }
  .cv-link a:hover {
    color: var(--text);
  }
</style>
