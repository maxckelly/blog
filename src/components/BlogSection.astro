---
import { getCollection } from 'astro:content';
import { groupBySeries, type SeriesGroup } from '../lib/series';

const posts = await getCollection('blog');
const { series, standalone } = groupBySeries(posts);

type Row =
  | { type: 'post'; date: Date; post: (typeof posts)[number] }
  | { type: 'series'; date: Date; series: SeriesGroup };

const rows: Row[] = [
  ...standalone.map((post) => ({ type: 'post' as const, date: post.data.date, post })),
  ...series.map((s) => ({ type: 'series' as const, date: s.latestDate, series: s })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
---

<section class="section">
  <h2 class="section-header">Blog</h2>
  {rows.map((row) =>
    row.type === 'post' ? (
      <a href={`/blog/${row.post.id}`} class="post-row">
        <span class="post-title">{row.post.data.title}</span>
        <span class="post-date muted">{formatDate(row.date)}</span>
      </a>
    ) : (
      <a href={`/series/${row.series.slug}`} class="post-row">
        <span class="post-title">
          {row.series.name}
          <span class="series-badge">{row.series.posts.length} parts</span>
        </span>
        <span class="post-date muted">{formatDate(row.date)}</span>
      </a>
    )
  )}
</section>

<style>
  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.4rem 0;
    border-bottom: none;
    gap: 1rem;
  }
  .post-row:hover .post-title {
    color: var(--accent);
  }
  .post-title {
    transition: color 0.2s;
  }
  .series-badge {
    font-size: 0.7rem;
    color: var(--text-muted);
    border: 1px solid var(--text-muted);
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
    margin-left: 0.5rem;
    white-space: nowrap;
    vertical-align: middle;
  }
  .post-date {
    font-size: 0.8rem;
    white-space: nowrap;
  }
</style>
